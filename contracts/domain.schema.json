{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "新作者成长识别领域资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "record_types",
    "workflow_states",
    "window_signals",
    "policies",
    "facts",
    "sample"
  ],
  "properties": {
    "domain": {
      "const": "emerging-creator-growth"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "record_types": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "workflow_states": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "window_signals": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "comparison",
        "history",
        "review",
        "transparency",
        "snapshot",
        "evaluation"
      ],
      "properties": {
        "comparison": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "transparency": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "evaluation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "type": "object",
      "minProperties": 3
    }
  },
  "additionalProperties": false
}
