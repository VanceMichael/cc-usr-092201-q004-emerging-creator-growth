{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "新作者成长识别领域资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "record_types",
    "workflow_states",
    "facts",
    "sample"
  ],
  "properties": {
    "domain": {
      "const": "emerging-creator-growth"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "record_types": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "allOf": [
        { "contains": { "const": "统计窗口" } },
        { "contains": { "const": "领域基准" } },
        { "contains": { "const": "数据快照" } },
        { "contains": { "const": "申诉记录" } }
      ]
    },
    "workflow_states": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "allOf": [
        { "contains": { "const": "观察中" } },
        { "contains": { "const": "待复核" } },
        { "contains": { "const": "申诉中" } }
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "type": "object",
      "minProperties": 3
    }
  },
  "additionalProperties": false
}
